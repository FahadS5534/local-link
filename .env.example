# Environment Configuration Example for LocalLink
# Copy this file to .env for local overrides, or supply values via --dart-define.

# Environment: development | staging | production
APP_ENV=development

# Application Identification
APP_NAME="LocalLink"
APP_APPLICATION_ID="com.locallink.mumbai"

# Firebase Configuration Placeholders (for Crowdsourcing features in Phase 6)
FIREBASE_PROJECT_ID=locallink-mumbai-dev
FIREBASE_API_KEY=AIzaSyFakePlaceholderApiKeyForDev
FIREBASE_APP_ID=1:123456789012:android:abcdef1234567890
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_STORAGE_BUCKET=locallink-mumbai-dev.appspot.com

# Feature Flags
ENABLE_CROWD_REPORTING=true
ENABLE_PROXIMITY_ALERTS=true
ENABLE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=10.0.2.2
FIREBASE_EMULATOR_PORT=8080
